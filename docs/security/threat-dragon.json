                {
                  "id": "e622157c-a77a-5599-a234-7f245e60b456",
                  "title": "T-R — Repudiation — әрекеттен бас тарту",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Repudiation",
                  "description": "Пайдаланушы сертификатқа әкелген нақты сұрауды жоққа шығарады\nНысан/ағын: F1, F3\nҚазіргі бақылау: logger және test_attempts бар; өзгертілмейтін толық аудит дәлелі жоқ\nИесі: Есеркенов Абдулазиз.\nАғымдағы күйі: Жоспарланған.\nSeverity — бастапқы сараптамалық баға, команда бекітеді.",
                  "mitigation": "Actor, request_id, action, object, outcome, timestamp аудиті; логты бөлек қорғау және сақтау мерзімі\nШара күйі: Жоспарланған.\nЖоспарланған шараны Mitigated деп белгілемеу керек.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": ""
                },
                {
                  "id": "371b5119-6126-54db-9328-0100ce742e8c",
                  "title": "T-D — Denial of service — қызмет көрсетуден бас тарту",
                  "status": "Open",
                  "severity": "High",
                  "type": "Denial of service",
                  "description": "Үлкен responses массиві не параллель submit БД пулын толтырады\nНысан/ағын: F1, API, БД пулы\nҚазіргі бақылау: express.json 10mb және жалпы rate limiter бар; бизнес-жиым көлемі шектелмеген\nИесі: Есеркенов Абдулазиз.\nАғымдағы күйі: Жоспарланған; жалпы шектеулер бар.\nSeverity — бастапқы сараптамалық баға, команда бекітеді.",
                  "mitigation": "Сұрақтар санына сай массив лимиті, timeout, concurrency шегі, submit rate limit, жүктеме тесті\nШара күйі: Жоспарланған; жалпы шектеулер бар.\nЖоспарланған шараны Mitigated деп белгілемеу керек.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": ""
                },
                {
                  "id": "88b791b2-574c-58b8-b12c-73314e60fff6",
                  "title": "T-E — Elevation of privilege — құқықты көтеру",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of privilege",
                  "description": "Ескі admin JWT рөл өзгергеннен кейін де admin құқықтарын сақтайды\nНысан/ағын: F1 және әкімшілік маршрут\nҚазіргі бақылау: adminMiddleware req.user.role мәніне сенеді; JWT-де role бар\nИесі: Есеркенов Абдулазиз.\nАғымдағы күйі: Ашық.\nSeverity — бастапқы сараптамалық баға, команда бекітеді.",
                  "mitigation": "Ағымдағы рөлді БД-дан тексеру немесе token version/revocation; рөл өзгерту теріс тесті\nШара күйі: Ашық.\nЖоспарланған шараны Mitigated деп белгілемеу керек.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 6,
                  "score": ""
                }
              ]
