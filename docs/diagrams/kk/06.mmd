    courses |o--o{ certificates : "course_id"
    tests |o--o{ certificates : "test_id"
    users |o--o{ feedback : "user_id"
    users |o--o{ user_errors : "user_id"
    courses |o--o{ user_errors : "course_id"
    lessons |o--o{ user_errors : "lesson_id"
